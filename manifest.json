{
  "manifest_version": 2,
  "name": "VFE MHTML 002",
  "version": "1.0.0",
  "description": "Save the active Firefox tab as a best-effort MHTML web archive. On-demand, local, and privacy focused.",
  "homepage_url": "https://github.com/flavius-vfe/VFE-MHTML-002",
  "browser_specific_settings": {
    "gecko": {
      "id": "vfe-mhtml-002@flavius-vfe.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "browser_action": {
    "default_title": "VFE MHTML 002 \u2014 Save page as MHTML",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
